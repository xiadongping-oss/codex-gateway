#!/bin/sh
# codex-gateway 提交守卫钩子（对应安全评审 B1）。
# 拦截活凭据（rt.1. / cgwadm- / cgw- / sk-）与个人绝对路径进入版本库。
# 安装：npm run hook:install（或手动 cp scripts/git-hooks/pre-commit .git/hooks/pre-commit）
root="$(git rev-parse --show-toplevel)"
node "$root/scripts/scan-secrets.mjs" --staged
status=$?
if [ "$status" -ne 0 ]; then
  echo "提交被密钥守卫拦截（见上方报告）。确认无误可用 git commit --no-verify 跳过，但不推荐。"
fi
exit $status
