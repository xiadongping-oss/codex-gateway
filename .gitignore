# ---------- 运行时机密 / 机器本地状态 ----------
#   .gw-config.json  含 OpenAI 官方 API Key、出网代理地址
#   api-keys.json    网关层 cgw- API Key 注册表（密文落盘，但仍是凭据）
gateway/.gw-config.json
gateway/api-keys.json
gateway/api-keys.json.tmp
# 统一原子落盘之后，所有数据文件的临时件都是「.<目标名>.<pid>.<随机12位hex>.tmp」
# 这个形状 —— 旧那条固定名已经拦不住它们了，这里按形状忽略。
# （gateway/data/ 下的同类临时文件由上面的 gateway/data/ 一并覆盖。）
gateway/*.tmp

# 控制面管理令牌（F-01 引入）：持它即可读写全部 Key / 账号 / 配置，
# 等同于本机管理员口令。绝不能进 public 仓库。
gateway/admin-token.json

# 多账号 OAuth 凭据：gateway/accounts/*.json 里是真实的 id_token / refresh_token，
# gateway/accounts.json 里是账号 ID、邮箱与登录指纹 —— 全部属于凭据，不可入库。
gateway/accounts/
gateway/accounts.json

# 网关运行时数据（调用日志 / 配额 / 素材源配置等），由 launcher 按需自建
gateway/data/

# 运行机本地状态：日志与本机选用的端口（logs/port.txt）。
# 端口属于「这台机器怎么部署」，不是项目配置，不该进仓库也不该随包分发。
gateway/logs/

# ---------- 本地开发 / 测试产物 ----------
# .verify/ 下是回归自检脚本与截图，属于本地开发环境，不随仓库分发
.verify/

# Vite 临时文件
*.timestamp-*

# ---------- 依赖 ----------
# 注：gateway/node_modules 里的 chatgpt-bridge 是**有意 vendored** 的
# （离线可用、免去 npx 下载），所以这里不忽略 gateway/node_modules。
frontend/node_modules

# ---------- 构建产物 ----------
# frontend/dist 是构建输出，但本项目需要它随包分发（启动器直接托管它），
# 因此保留在版本控制内。

# ---------- 内部文档 ----------
docs/review-report.html

# ---------- 系统 / 编辑器 ----------
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# 发布产物（zip 与 staging 中间目录不入库；构建方式见 docs/RELEASE.md）
release/

# Tauri build caches and generated resources (no user data or machine paths in Git)
desktop/.generated/
desktop/src-tauri/target/
desktop/src-tauri/gen/
output/desktop-validation/
output/desktop-ci/
