{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Gateway",
  "version": "1.14.9",
  "identifier": "com.codexgateway.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'none'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": false,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGOTU3NzhEMzVCOUNEQTkKUldTcHpiazFqWGVWMzlTUVBBbzZiVnFtVzVydExldFNqdFNpRi9wRExJYTdRS29pTE1SQXA3bVIK",
      "endpoints": [
        "https://github.com/xiadongping-oss/codex-gateway/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
