# 复制本文件为 .env 并按需修改

# 是否使用内置 mock 数据（默认 true，无需后端即可预览）
VITE_USE_MOCK=true

# 真实网关地址（chatgpt-bridge 默认 127.0.0.1:10531，OpenAI 兼容 /v1 根）
#   - 留空（推荐）：前端由本地启动器（gateway/launcher.mjs）同源托管，
#     所有 /v1、/health、/__gw 请求走相对路径，启动器自动拉起 bridge。
#   - 填绝对地址：直连已手动启动的 bridge（如 http://127.0.0.1:10531）。
VITE_API_BASE=

# 说明：
#   1) 登录态来自官方 `npx @openai/codex login`（写入 ~/.codex/auth.json），bridge 自动读取
#   2) bridge 忽略 apiKey，浏览器/客户端填任意值即可
#   3) 修改后需重启 dev server（npm run dev）或重新 build（npm run build）才生效
