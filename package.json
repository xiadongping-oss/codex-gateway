{
  "name": "codex-gateway",
  "version": "1.12.1",
  "private": true,
  "type": "module",
  "main": "gateway/launcher.mjs",
  "description": "Codex 本地网关：Vue 控制台 + chatgpt-bridge 薄代理，一键本地托管（OpenAI 兼容 API、多账号、生图、素材管理）",
  "scripts": {
    "start": "node gateway/launcher.mjs --open",
    "start:lan": "node gateway/launcher.mjs --lan --open",
    "start:headless": "node gateway/launcher.mjs",
    "admin": "node gateway/launcher.mjs admin",
    "build": "npm --prefix frontend run build",
    "setup": "npm --prefix gateway install && npm run prepare:bridge",
    "prepare:bridge": "node prepare-bridge.mjs",
    "test:bridge-patches": "node --test --test-timeout=15000 gateway/tests/bridge-patches.test.mjs",
    "test:storage": "node --test --test-timeout=60000 gateway/tests/storage.test.mjs gateway/tests/storage-integration.test.mjs",
    "login": "npx @openai/codex login",
    "test": "node gateway/tests/run-audit.mjs",
    "test:unit": "node --test --test-timeout=15000 gateway/tests/bridge-pool.test.mjs gateway/tests/bridge-patches.test.mjs gateway/tests/quota.test.mjs gateway/tests/failover.test.mjs gateway/tests/lan-addr.test.mjs gateway/tests/port.test.mjs gateway/tests/tool-call.test.mjs gateway/tests/hardening.test.mjs gateway/tests/vbs-static.test.mjs gateway/tests/token-text.test.mjs gateway/tests/official-login.test.mjs gateway/tests/api-providers.test.mjs",
    "test:client": "node --test --test-timeout=60000 gateway/tests/setup-client.test.mjs",
    "test:build": "node --test --test-timeout=60000 gateway/tests/build-release.test.mjs",
    "test:mutate": "node gateway/tests/mutate.mjs",
    "test:mutate:build": "node gateway/tests/mutate-build.mjs",
    "test:mutate:client": "node gateway/tests/mutate-client.mjs",
    "test:unix": "node --test --test-timeout=120000 gateway/tests/service-unix.test.mjs",
    "test:mutate:hardening": "node gateway/tests/mutate-hardening.mjs",
    "test:mutate:unix": "node gateway/tests/mutate-unix.mjs",
    "test:mutate:failover": "node gateway/tests/mutate-failover.mjs",
    "test:mutate:lanaddr": "node gateway/tests/mutate-lanaddr.mjs",
    "test:attack": "node gateway/tests/pentest.mjs",
    "test:bench": "node gateway/tests/bench-concurrency.mjs",
    "test:mutate:port": "node gateway/tests/mutate-port.mjs",
    "test:mutate:toolcall": "node gateway/tests/mutate-toolcall.mjs",
    "test:desktop": "node --test --test-timeout=60000 gateway/tests/desktop.test.mjs gateway/tests/desktop-integration.test.mjs",
    "prepare:runtime": "node prepare-runtime.mjs",
    "prepare:desktop": "node prepare-desktop.mjs",
    "test:runtime": "node --test --test-timeout=60000 gateway/tests/runtime-resources.test.mjs",
    "test:prepared": "node gateway/tests/prepared-resources-smoke.mjs",
    "test:desktop:regression": "node --test --test-timeout=120000 gateway/tests/desktop-regression.test.mjs",
    "desktop:build": "node desktop/build.mjs --locked",
    "desktop:test": "node desktop/build.mjs --test --locked",
    "desktop:smoke": "node desktop/smoke.mjs",
    "desktop:verify": "node desktop/verify.mjs",
    "desktop:verify:test": "node --test desktop/validation.test.mjs"
  }
}
