{
  "name": "codex-gateway",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "main": "gateway/launcher.mjs",
  "description": "Codex 本地网关：Vue 控制台 + chatgpt-bridge 薄代理，一键本地托管（OpenAI 兼容 API、多账号、生图、素材管理）",
  "scripts": {
    "start": "node gateway/launcher.mjs --open",
    "start:lan": "node gateway/launcher.mjs --lan --open",
    "start:headless": "node gateway/launcher.mjs",
    "admin": "node gateway/launcher.mjs admin",
    "build": "npm --prefix frontend run build",
    "setup": "npm --prefix gateway install",
    "login": "npx @openai/codex login",
    "test": "bash gateway/tests/run.sh",
    "test:unit": "node --test --test-timeout=15000 gateway/tests/bridge-pool.test.mjs gateway/tests/quota.test.mjs gateway/tests/failover.test.mjs",
    "test:client": "node --test --test-timeout=60000 gateway/tests/setup-client.test.mjs",
    "test:build": "node --test --test-timeout=60000 gateway/tests/build-release.test.mjs",
    "test:mutate": "node gateway/tests/mutate.mjs",
    "test:mutate:build": "node gateway/tests/mutate-build.mjs",
    "test:mutate:client": "node gateway/tests/mutate-client.mjs",
    "test:unix": "node --test --test-timeout=120000 gateway/tests/service-unix.test.mjs",
    "test:mutate:unix": "node gateway/tests/mutate-unix.mjs",
    "test:mutate:failover": "node gateway/tests/mutate-failover.mjs",
    "test:attack": "node gateway/tests/pentest.mjs",
    "test:bench": "node gateway/tests/bench-concurrency.mjs"
  }
}
