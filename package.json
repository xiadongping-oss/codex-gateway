{
  "name": "codex-gateway",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "gateway/launcher.mjs",
  "description": "Codex 本地网关：Vue 控制台 + chatgpt-bridge 薄代理，一键本地托管（OpenAI 兼容 API、多账号、生图、素材管理）",
  "scripts": {
    "start": "node gateway/launcher.mjs",
    "start:lan": "node gateway/launcher.mjs --lan",
    "build": "npm --prefix frontend run build",
    "setup": "npm --prefix gateway install",
    "login": "npx @openai/codex login"
  }
}